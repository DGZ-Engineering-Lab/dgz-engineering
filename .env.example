# ==========================================
# DEVGIZ - MASTER ENVIRONMENT CONFIGURATION
# ==========================================

# 1. SUPABASE (Autenticación y Almacenamiento de Archivos)
# Obtén estos valores en: Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://TU_PROYECTO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="TU_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="TU_SUPABASE_SERVICE_ROLE_KEY" # ¡NUNCA pongas esto en Vercel, solo en Render!

# 2. NEON (Base de Datos Serverless Premium)
# Obtén esto en: Neon Dashboard -> Connection Details
# Formato: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@HOST/neondb?sslmode=require"

# 3. RENDER API (Tu procesador GIS en Python)
# Cuando despliegues en Render, te darán una URL. Vercel usará esta URL para mandarle datos.
NEXT_PUBLIC_GEOAPI_URL="https://devgiz-api.onrender.com"

# 4. SENTRY (Observabilidad & Performance)
# DSN del proyecto de FastAPI/Next.js y credenciales para uploads de Source Maps
NEXT_PUBLIC_SENTRY_DSN="https://TU_KEY@oXXXX.ingest.us.sentry.io/XXXX"
SENTRY_DSN="https://TU_KEY@oXXXX.ingest.us.sentry.io/XXXX"
SENTRY_ORG="devgiz"
SENTRY_PROJECT="javascript-nextjs"

# 5. POSTHOG (Analítica de Comportamiento & Session Replays)
# Token público del proyecto y host de ingesta
NEXT_PUBLIC_POSTHOG_KEY="phc_TU_POSTHOG_PROJECT_KEY"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# 6. RENDER (Tu servicio GIS en la nube)
# Esta es la URL pública de tu API en Render. Se usa para integrar tu procesador GIS con la app de Next.js
RENDER_API_URL="https://devgiz-api.onrender.com"

# 7. UPSTASH (Cache y Rate Limiting Premium)
# URL de API REST de tu instancia Redis en Upstash
UPSTASH_REDIS_REST_URL="https://TU_INSTANCIA.upstash.io"
UPSTASH_REDIS_REST_TOKEN="TU_UPSTASH_TOKEN"


# 8.GOOGLE MAPS (API Key para OpenStreetMap)
# Necesaria si decides usar alternativas a Mapbox
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="TU_API_KEY_DE_GOOGLE_MAPS"

NEXT_PUBLIC_MAPBOX_TOKEN="pk.TU_MAPBOX_PUBLIC_TOKEN_AQUI"

# Link de pago Wompi para el anticipo del Piloto WebGIS Municipal (gratis de crear
# en comercios.wompi.co > Links de pago). Si se deja vacío, el botón no aparece.
NEXT_PUBLIC_WOMPI_PILOTO_WEBGIS_URL=""

# 9. CRON JOB (Mantenimiento Nocturno Vercel)
# Secreto aleatorio para proteger el endpoint /api/cron de peticiones externas.
# Genéralo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="tu_secreto_aleatorio_aqui_64_caracteres"

# 10. RESEND (Email Transaccional Enterprise)
# Obtén tu API key en https://resend.com/api-keys
RESEND_API_KEY="re_tus_credenciales_aqui"
# Para usar Enterprise Business Premium debes configurar y verificar tu propio dominio en Resend
RESEND_FROM_EMAIL="onboarding@resend.dev" # Free Tier: Solo puede enviar a admin email
RESEND_ADMIN_EMAIL="tu_correo@ejemplo.com"
# Audiencias (Para agregar usuarios y hacer Broadcasts)
RESEND_AUDIENCE_ID="ID_DE_TU_AUDIENCE_EN_RESEND"
# Webhooks (Para escuchar eventos como rebotados, entregados)
RESEND_WEBHOOK_SECRET="whsec_TU_SECRETO_DE_WEBHOOK"

# 11. PANEL ADMIN (/admin)
# Obligatorio para entrar al panel. Mínimo 12 caracteres; sin esta variable el panel queda bloqueado.
# Genéralo con: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSCODE="tu_passcode_largo_y_aleatorio"

# 12. VERCEL BLOB (subida de capas GeoJSON)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_TU_TOKEN"

# 13. GROQ (motor GeoAI)
GROQ_API_KEY="gsk_TU_GROQ_API_KEY"

# 14. SEO (Dominio canónico y verificación en buscadores)
# URL pública definitiva del sitio, sin barra final. Por defecto: https://devgiz.vercel.app
NEXT_PUBLIC_SITE_URL="https://devgiz.vercel.app"
# Código de la etiqueta meta de Google Search Console (solo el valor de content)
GOOGLE_SITE_VERIFICATION=""
# Código de verificación de Bing Webmaster Tools (msvalidate.01)
BING_SITE_VERIFICATION=""
