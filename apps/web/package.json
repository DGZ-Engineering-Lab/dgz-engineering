{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.6.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.34.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.1",
    "@vercel/edge-config": "^1.5.1",
    "@vercel/kv": "^3.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "animejs": "^4.5.0",
    "framer-motion": "^14.1.0",
    "groq-sdk": "^1.6.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.55.0",
    "mapbox-gl": "^3.32.0",
    "next": "16.4.1",
    "posthog-js": "^1.374.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.1",
    "svix": "^2.8.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10",
    "eslint-config-next": "16.4.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
